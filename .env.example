# Copy this file to .env and fill in the values for local development.
# Never commit .env — it is listed in .gitignore.

# AlloyDB (gcp profile)
ALLOYDB_INSTANCE_URI=projects/my-project/locations/us-central1/clusters/my-cluster/instances/my-instance
ALLOYDB_DB_NAME=loandb
ALLOYDB_IAM_USER=svc-account@my-project.iam.gserviceaccount.com
ALLOYDB_IP_TYPE=PRIVATE

# Bigtable
BIGTABLE_PROJECT_ID=my-project
BIGTABLE_INSTANCE_ID=my-instance
BIGTABLE_APP_PROFILE_ID=default

# Downstream REST service
DOWNSTREAM_BASE_URL=https://loan-servicing-api.example.com

# Security — OAuth2 JWT Resource Server (gcp profile only)
OAUTH2_ISSUER_URI=https://accounts.google.com
OAUTH2_AUDIENCE=https://loan-data-api.example.com
